node_modules/
.next/
out/
build/
.DS_Store
*.log
*.zip

# env files
.env
.env.local
# Any copy of one, however it was named. A backup of an env file is
# still an env file, and `git add -A` does not know the difference.
.env*.bak*
.env.local.*
.env.provisioning

# Provisioning state: database passwords and service-role keys for
# instances this machine created. Never committed.
#
# No trailing slash, deliberately. The worktree ritual in CLAUDE.md
# symlinks this from the main checkout, and git treats a symlink as
# a file, so a directory-only pattern did not match it: every new
# worktree showed it as untracked and one `git add -A` away from
# being committed. This one holds service-role keys.
.provisioning-state
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin
# Same as .provisioning-state above: symlinked per worktree, so the
# pattern cannot be directory-only.
.claude

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.next-e2e-unresolved/

# Real client content used for regression runs. Transcripts and the
# expected values derived from them are never committed.
.regression/
