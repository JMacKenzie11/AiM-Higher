{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // .next-e2e-unresolved and .next-e2e-prod are the other two servers'
  // build outputs (see playwright.config.ts). Listed so Next doesn't
  // rewrite and reformat this file every time the e2e suite runs.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-e2e-unresolved/types/**/*.ts",
    ".next-e2e-prod/types/**/*.ts"
  ],
  // scripts/ is checked by scripts/tsconfig.json instead, which is the
  // only place allowImportingTsExtensions is turned on. Excluded here
  // so the app keeps the stricter setting.
  "exclude": ["node_modules", "scripts"]
}
