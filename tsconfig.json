{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // scripts/ runs outside the Next build under
    // --experimental-strip-types, which resolves ESM imports by their
    // real filename and so needs the .ts extension written out. Safe
    // here because noEmit is on: nothing is compiled to JS, so there
    // is no output whose extensions could be wrong.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // .next-e2e-unresolved is the second dev server's build output (see
  // playwright.config.ts). Listed so `next dev` doesn't rewrite and
  // reformat this file every time the e2e suite runs.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-e2e-unresolved/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
