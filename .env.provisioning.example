# Configuration for `npm run provision` (scripts/provision-instance.ts).
#
# Copy to .env.provisioning and fill in. That file is gitignored: it
# holds tokens that can create databases and rewrite production
# environment variables, which is a wider blast radius than anything in
# .env.local.
#
# All five values must be here. .env.local is deliberately NOT read as
# a fallback: its CONTROL_PLANE_* get repointed at the dev clone during
# local resolution testing, and provisioning inheriting those would
# write the registry row into the clone instead of production. A
# missing value stops the run; a wrong one would not.

# Supabase Management API — creates the customer's project.
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=

# Vercel — writes {PREFIX}_SUPABASE_* to the project and redeploys.
# Token: https://vercel.com/account/tokens
# Project id: Vercel → the project → Settings → General.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# The control plane, which holds public.instances. Provisioning writes
# the registry row here, and that row is what makes the new hostname
# resolve at all. This must be PRODUCTION — copy the values in fresh,
# do not assume the ones in .env.local are still pointed there.
# See docs/deployment.md.
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SUPABASE_SERVICE_KEY=
