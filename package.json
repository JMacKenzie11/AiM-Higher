{
  "name": "aims-execution-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "dev:fresh": "rm -rf .next && next dev -p 3200",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build",
    "start": "next start -p 3200",
    "lint": "next lint --dir src --dir scripts --dir e2e",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "node --env-file=.env.local --experimental-strip-types scripts/seed-admin.ts",
    "seed:instances": "node --env-file=.env.local --experimental-strip-types scripts/seed-instances.ts",
    "seed:e2e": "node --env-file=.env.local --experimental-strip-types scripts/seed-e2e.ts",
    "migrate:instances": "tsx --tsconfig scripts/tsconfig.json scripts/migrate-instances.ts",
    "migrate:dev": "tsx --tsconfig scripts/tsconfig.json scripts/migrate-instances.ts --dev",
    "ship:batch": "bash scripts/ship-batch.sh",
    "scrub:dev": "tsx --tsconfig scripts/tsconfig.json scripts/scrub-dev-secrets.ts",
    "sync:content": "tsx --tsconfig scripts/tsconfig.json scripts/sync-content.ts",
    "verify:fleet": "tsx --tsconfig scripts/tsconfig.json scripts/verify-fleet.ts",
    "repair:scorecard-snapshots": "tsx --tsconfig scripts/tsconfig.json scripts/repair-scorecard-gated-snapshots.ts",
    "repair:chart-baseline": "tsx --tsconfig scripts/tsconfig.json scripts/repair-chart-baseline-rows.ts",
    "repair:howard-priorities": "tsx --tsconfig scripts/tsconfig.json scripts/repair-howard-duplicate-priorities.ts",
    "provision": "tsx --tsconfig scripts/tsconfig.json scripts/provision-instance.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "seed:user": "node --env-file=.env.local --experimental-strip-types scripts/seed-user.ts",
    "seed:demo": "node --env-file=.env.local --experimental-strip-types scripts/seed-demo.ts",
    "seed:construction": "node --env-file=.env.local --experimental-strip-types scripts/seed-construction.ts",
    "seed:meridian-measures": "node --env-file=.env.local --experimental-strip-types scripts/seed-meridian-measures.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs-touched.ts",
    "check:help": "node --experimental-strip-types scripts/check-help-coverage.ts",
    "rls:hazards": "tsx --tsconfig scripts/tsconfig.json scripts/rls-harness.ts",
    "guide:uptake": "tsx --tsconfig scripts/tsconfig.json scripts/guide-uptake.ts",
    "posthog:insights": "node --env-file=.env.local --experimental-strip-types scripts/setup-posthog-insights.ts",
    "instance:primary": "tsx --tsconfig scripts/tsconfig.json scripts/mark-primary.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.5",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "docx": "^9.7.1",
    "googleapis": "^173.0.0",
    "mammoth": "^1.12.0",
    "next": "15.5.20",
    "posthog-js": "^1.418.12",
    "posthog-node": "^5.51.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
