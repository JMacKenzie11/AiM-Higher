{
  "name": "aims-execution-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "dev:fresh": "rm -rf .next && next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push:dev": "scripts/db-push.sh dev",
    "db:push:prod": "scripts/db-push.sh prod",
    "seed:admin": "node --env-file=.env.local --experimental-strip-types scripts/seed-admin.ts",
    "seed:demo": "node --env-file=.env.local --experimental-strip-types scripts/seed-demo.ts",
    "seed:construction": "node --env-file=.env.local --experimental-strip-types scripts/seed-construction.ts",
    "seed:meridian-measures": "node --env-file=.env.local --experimental-strip-types scripts/seed-meridian-measures.ts",
    "check:help": "node --experimental-strip-types scripts/check-help-coverage.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@anthropic-ai/sdk": "^0.111.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.5",
    "@tiptap/html": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "ai": "^7.0.31",
    "googleapis": "^173.0.0",
    "mammoth": "^1.12.0",
    "next": "15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
