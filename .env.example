# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Site URL. Used for auth redirect targets, the Google OAuth callback
# destination, marketing SEO metadata (canonical + og:url), and the
# OG image footer. Set to the production URL in Vercel
# (e.g. https://aims-hq.com).
NEXT_PUBLIC_APP_URL=http://localhost:3200

# PostHog product analytics. Ingest-only project key (safe to expose
# in the browser). Provider mounts inside the authenticated (app)
# layout only — public marketing pages are intentionally not
# tracked. Leave unset to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Only needed for `npm run posthog:insights` (creates/updates the
# starter set of saved insights in PostHog). Personal API key
# tied to your PostHog user, NOT the project key above. Create
# at PostHog → Settings → Personal API keys with scopes
# insight:write + project:read. Project ID is the numeric id
# visible in the PostHog URL: us.posthog.com/project/<id>/home.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Server only — never import from client code
SUPABASE_SERVICE_ROLE_KEY=

# Sender for Resend-dispatched transactional email (meeting-analysis
# commitment digests + invite resends via lib/email.ts). Format is
# "Name <address>". Falls back to a sensible production default when
# unset. Auth invitations + password reset go through Supabase's own
# SMTP settings (Auth → SMTP), NOT this variable.
EMAIL_FROM=
RESEND_API_KEY=

# Database connection strings for `npm run db:push:dev` and
# `npm run db:push:prod` (Supabase CLI). Get these from the Supabase
# dashboard: Project Settings → Database → Connection String → URI
# (use the "Direct connection" URL, not the pooler).
SUPABASE_DEV_DB_URL=
SUPABASE_PROD_DB_URL=

# AI leadership coaching — server-only. The API key must never be
# imported from client code. ANTHROPIC_COACH_MODEL falls back to
# claude-sonnet-4-6 if unset, but set it explicitly to pin the model
# (e.g. claude-opus-4-7, or whatever version you standardize on).
ANTHROPIC_API_KEY=
ANTHROPIC_COACH_MODEL=

# Seed script (server only, see scripts/seed-admin.ts).
# Provide any number of admins. Two patterns are supported:
#   Single:   SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD / SEED_ADMIN_NAME
#   Numbered: SEED_ADMIN_1_EMAIL / SEED_ADMIN_1_PASSWORD / SEED_ADMIN_1_NAME
#             SEED_ADMIN_2_EMAIL / SEED_ADMIN_2_PASSWORD / SEED_ADMIN_2_NAME
#             … up to SEED_ADMIN_9_*
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_2_EMAIL=
SEED_ADMIN_2_PASSWORD=
SEED_ADMIN_2_NAME=

# ---- Instance resolution -------------------------------------
# Which database a request belongs to is decided by
# src/lib/instances/resolve.ts, in this order. There is no fallback:
# a request that resolves to nothing gets nothing, because falling
# back to a default database is how one customer reads another
# customer's rows.
#
# 1. LOCAL_INSTANCE_*  — a developer's override. When these are set
#    the hostname is ignored entirely and every request goes to this
#    database, which is how local dev pins itself to the dev project.
#    All three or none: a partial set throws at resolution time,
#    naming what's missing, because a silent null there looks exactly
#    like an unknown hostname.
LOCAL_INSTANCE_SUPABASE_URL=
LOCAL_INSTANCE_SUPABASE_ANON_KEY=
LOCAL_INSTANCE_SUPABASE_SERVICE_KEY=

# 2. PREVIEW_INSTANCE_*  — every *.vercel.app deployment. Preview
#    URLs are generated per deployment, so they can never be
#    registered as instances and all share one preview database.
#    Set these in Vercel on the Preview environment only. All three
#    are required; a partial set resolves to null rather than
#    throwing, so a misconfigured preview fails the request instead
#    of the process.
PREVIEW_INSTANCE_SUPABASE_URL=
PREVIEW_INSTANCE_SUPABASE_ANON_KEY=
PREVIEW_INSTANCE_SUPABASE_SERVICE_KEY=

# 3. The registry — the public.instances table (migration 0169),
#    read by src/lib/instances/registry.ts. A row maps a subdomain to
#    an env_prefix; the keys themselves are never in the database,
#    they're read from {PREFIX}_SUPABASE_URL / _ANON_KEY /
#    _SERVICE_KEY at runtime. A row whose variables are missing logs
#    and resolves to null.
#
#    The apex domain and www resolve as the subdomain "@", borrowed
#    from DNS zone files. aims-hq.com and www.aims-hq.com both look
#    up the "@" row; acme.aims-hq.com looks up "acme". Without an "@"
#    row the live domain resolves to nothing and every path on it is
#    rewritten to /instance-not-found, so that row is a deployment
#    prerequisite, not an optimisation. Write rows with
#    `npm run seed:instances` (scripts/seed-instances.ts).
#
# The control plane holds that table. Today it's the production
# project, so in production these carry the same values as
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY. They're
# named separately on purpose: nothing in the registry code may
# reference the app's variables, so moving the table to its own
# project later is an environment change, not a code change.
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SUPABASE_SERVICE_KEY=

# One set per registered instance, named by that row's env_prefix.
# PROD_ is the first of them: the row with env_prefix 'PROD'.
#
# PROD_ has a second job. The cron routes are excluded from instance
# resolution entirely (src/lib/instances/middleware-decision.ts): a
# scheduled invocation has no visitor and no meaningful hostname, so
# it names its database rather than inferring one, and
# getCurrentInstanceConfig() reads these. If neither PROD_* nor
# LOCAL_INSTANCE_* is complete, a cron route throws rather than
# guessing — see src/lib/instances/current.ts.
PROD_SUPABASE_URL=
PROD_SUPABASE_ANON_KEY=
PROD_SUPABASE_SERVICE_KEY=

# Registry rows for `npm run seed:instances`. Single or numbered
# (SEED_INSTANCE_1_*, SEED_INSTANCE_2_*, … up to 9). _STATUS is
# optional and defaults to 'active'. Use "@" for the apex and www.
SEED_INSTANCE_SUBDOMAIN=@
SEED_INSTANCE_DISPLAY_NAME=AiMS Higher
SEED_INSTANCE_ENV_PREFIX=PROD
SEED_INSTANCE_STATUS=active
